pipeline {

    agent any

    stages {

        stage('Clone Code') {
            steps {
                git branch: 'master',
                url: 'git@github.com:Venki-maan/Employee-manage.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Check Versions') {
            steps {
                sh 'node --version'
                sh 'npm --version'
            }
        }
    }
}
